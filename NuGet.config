<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources are pinned here rather than inherited from the machine or the build agent.

    Without this, restore uses whatever sources happen to be configured in the user or machine
    NuGet.config - which on a corporate workstation or a shared agent routinely includes private
    feeds. A private feed that serves a package with one of these IDs would then be preferred or
    consulted, which is the dependency-confusion path. These are public packages with public
    dependencies, so nuget.org is the only source that should ever be used.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Bind every package ID to nuget.org explicitly. With a single source this is belt-and-braces,
    but it means adding a second source later cannot silently widen where existing packages may
    come from: a new source resolves nothing until it is given its own pattern.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
