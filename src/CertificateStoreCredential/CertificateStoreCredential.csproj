<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A TokenCredential for an Entra service principal that authenticates with a client certificate
    from the Windows certificate store. It knows nothing about Key Vault, configuration or logging,
    which is why it is a package of its own: KeyVaultReferenceResolver depends on it, and so can any
    application that needs a token for another service (Azure SQL, for example) without taking on
    the resolver. The only package dependency is Azure.Identity.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Information -->
    <PackageId>CertificateStoreCredential</PackageId>
    <Version>1.0.0</Version>
    <PackageReleaseNotes>Initial release. A TokenCredential for an Entra service principal using a client certificate from the Windows certificate store, with a non-exportable private key if need be. Found by thumbprint or by the client ID in the subject, or by the AZURE_TENANT_ID / AZURE_CLIENT_ID convention.</PackageReleaseNotes>
    <Authors>Gijs Walraven</Authors>
    <Company>Gijs Walraven</Company>
    <Description>A TokenCredential for an Entra ID service principal that authenticates with a client certificate from the Windows certificate store, including certificates with a non-exportable private key. Set AZURE_TENANT_ID and AZURE_CLIENT_ID and name the certificate after the client ID: no thumbprint, no secret on disk, no certificate-specific code. Depends only on Azure.Identity.</Description>
    <PackageTags>Azure;Entra;Credential;Certificate;CertificateStore;ServicePrincipal;Azure.Identity;TokenCredential</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gijswalraven/KeyVaultReferenceResolver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gijswalraven/KeyVaultReferenceResolver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2025-2026 Gijs Walraven and contributors</Copyright>

    <!-- SourceLink for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal members are exposed to the test project so that the store-lookup and validation
         rules can be asserted on with in-memory certificates, without touching the machine's
         certificate store. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CertificateStoreCredential.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
