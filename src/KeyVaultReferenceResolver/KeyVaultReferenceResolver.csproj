<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Information -->
    <PackageId>KeyVaultReferenceResolver</PackageId>
    <Version>2.1.0</Version>
    <PackageReleaseNotes>Minor release. Adds authentication with a client certificate from the Windows certificate store: set options.ClientCertificate, or set AZURE_TENANT_ID and AZURE_CLIENT_ID and name a store certificate after the client ID. The certificate logic is the new CertificateStoreCredential package, which this package now depends on. No change unless a certificate that names AZURE_CLIENT_ID exists in the store.</PackageReleaseNotes>
    <Authors>Gijs Walraven</Authors>
    <Company>Gijs Walraven</Company>
    <Description>Resolve Azure Key Vault references in Microsoft.Extensions.Configuration using both @Microsoft.KeyVault(SecretUri=...) and @Microsoft.KeyVault(VaultName=...;SecretName=...) formats. Works locally, in Docker, Kubernetes, and anywhere - not just Azure App Service.</Description>
    <PackageTags>Azure;KeyVault;Configuration;Secrets;AzureKeyVault;AppService</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gijswalraven/KeyVaultReferenceResolver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gijswalraven/KeyVaultReferenceResolver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2025-2026 Gijs Walraven and contributors</Copyright>

    <!-- SourceLink for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CertificateStoreCredential\CertificateStoreCredential.csproj" />
  </ItemGroup>

  <!--
    The project reference is for development; the published package depends on the
    CertificateStoreCredential package. Pack turns a project reference into "version >= its
    version", with no upper bound, so a future 2.x of that package with breaking changes would be
    accepted. This narrows the dependency to the 1.x line. Raise the range deliberately, together
    with the reference, when a new major version of CertificateStoreCredential is adopted.
  -->
  <Target Name="NarrowCertificateStoreCredentialRange" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'CertificateStoreCredential'" ProjectVersion="[1.0.0, 2.0.0)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Internal members are exposed to the test project so that the credential and
         client-options builders can be asserted on directly. Without this the only way
         to test them is through a live vault call. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KeyVaultReferenceResolver.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KeyVaultReferenceResolver.TestSupport</_Parameter1>
    </AssemblyAttribute>
    <!-- The HashiCorp package shares the ConfigurationManager disposal rule rather than
         restating it; getting it wrong in one of the two is the failure mode to avoid. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KeyVaultReferenceResolver.HashiCorp</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
